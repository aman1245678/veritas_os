{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritas-os.example/schemas/neomundi_rgc_v01_complete_intake_manifest.schema.json",
  "title": "NeoMundi RGC v0.1.0 Historical COMPLETE Intake Manifest",
  "description": "Explicit historical schema 0.1.0 packet correlation only. Full signal semantics and independent key trust are enforced separately; this manifest never creates permission or freshness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "manifest_id",
    "provider_id",
    "artifact_type",
    "artifact_version",
    "artifact_id",
    "expected_key_id",
    "expected_signer_identity",
    "artifact_file_sha256",
    "trusted_jwks_file_sha256",
    "trusted_key_provenance_receipt_file_sha256",
    "handoff_reference",
    "received_at"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "const": "1.0"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_id": {
      "type": "string",
      "const": "neomundi"
    },
    "artifact_type": {
      "type": "string",
      "const": "neomundi_rgc"
    },
    "artifact_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "description": "Expected RGC identity.request_id."
    },
    "expected_key_id": {
      "type": "string",
      "minLength": 1,
      "description": "Expected RGC integrity.key_id."
    },
    "expected_signer_identity": {
      "type": "string",
      "minLength": 1,
      "description": "Expected RGC integrity.signer_identity."
    },
    "artifact_file_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trusted_jwks_file_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trusted_key_provenance_receipt_file_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "handoff_reference": {
      "type": "string",
      "minLength": 1,
      "description": "Reviewer/operator reference for the partner handoff. It is not proof that the handoff channel is authentic."
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "description": "Audit metadata for when the packet was received. VERITAS does not use this field as evidence freshness or trusted UTC."
    }
  }
}
