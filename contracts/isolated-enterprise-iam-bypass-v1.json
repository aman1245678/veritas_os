{
  "contract_id": "ISOLATED_ENTERPRISE_IAM_BYPASS_V1",
  "contract_version": "1.0.0",
  "status": "SPECIFICATION_ONLY_NOT_EXECUTED",
  "rule_of_one": "EXTERNAL_ENFORCEMENT_DENIES_UNGOVERNED_IAM_MUTATION",
  "frozen_base_sha": "df61a74c7405e69e2660c0c457025696ade424bf",
  "production_claim": false,
  "external_api_calls_allowed": false,
  "cost_boundary": "No paid provider calls; GitHub Actions runner minutes may still accrue.",
  "action": {
    "method": "POST",
    "path": "/v1/iam/users/contractor-001/roles",
    "body": {
      "role": "admin"
    },
    "scope": "saas:grant_admin",
    "target": "synthetic-user:contractor-001",
    "effect": "synthetic IAM role grant persisted in an isolated target-owned database"
  },
  "actors": {
    "agent": {
      "networks": [
        "agent_net"
      ],
      "can_resolve_effect_service": false,
      "effect_credentials": false,
      "docker_socket": false
    },
    "governed_executor": {
      "networks": [
        "agent_net",
        "effect_net"
      ],
      "effect_credentials": true,
      "must_consume_veritas_authorization": true
    },
    "effect_service": {
      "networks": [
        "effect_net"
      ],
      "host_published_ports": false,
      "verifies_client_identity": true,
      "verifies_scoped_authority": true
    },
    "independent_observer": {
      "access": "read-only target-state snapshot and generated network/runtime evidence"
    }
  },
  "case_matrix": [
    {
      "case_id": "ALLOW_01",
      "route": "governed",
      "condition": "valid bound authority + verified human approval + one-time authorization",
      "expected_boundary": "TARGET_COMMIT",
      "expected_effect_delta": 1
    },
    {
      "case_id": "DENY_01",
      "route": "governed",
      "condition": "missing or invalid approval",
      "expected_boundary": "VERITAS_PRE_DISPATCH_DENY",
      "expected_effect_delta": 0
    },
    {
      "case_id": "DENY_02",
      "route": "direct_agent_to_target",
      "condition": "agent on agent_net cannot route to effect_net",
      "expected_boundary": "NETWORK_UNREACHABLE",
      "expected_effect_delta": 0
    },
    {
      "case_id": "DENY_03",
      "route": "independent_negative_probe",
      "condition": "probe temporarily on effect_net without trusted client credential",
      "expected_boundary": "TLS_CLIENT_IDENTITY_REJECTED",
      "expected_effect_delta": 0
    },
    {
      "case_id": "DENY_04",
      "route": "independent_negative_probe",
      "condition": "network-reachable authenticated test identity without the action scope",
      "expected_boundary": "TARGET_POLICY_403",
      "expected_effect_delta": 0
    },
    {
      "case_id": "DENY_05",
      "route": "governed_replay",
      "condition": "reuse already-consumed authorization for identical mutation",
      "expected_boundary": "VERITAS_REPLAY_DENY",
      "expected_effect_delta": 0
    },
    {
      "case_id": "DENY_06",
      "route": "governed",
      "condition": "valid approval but mismatched target or scope",
      "expected_boundary": "VERITAS_BIND_MISMATCH_DENY",
      "expected_effect_delta": 0
    },
    {
      "case_id": "RECON_01",
      "route": "observer",
      "condition": "read-only reconciliation of the committed mutation",
      "expected_boundary": "EXACTLY_ONE_TARGET_EFFECT_CONFIRMED",
      "expected_effect_delta": 0
    }
  ],
  "must_capture": [
    "run_id",
    "tested_sha",
    "source_sha",
    "base_sha",
    "deployment_image_digests",
    "resolved_network_topology_digest",
    "temporary_certificate_authority_fingerprint",
    "case_id",
    "request_id",
    "decision_id",
    "execution_intent_id",
    "authorization_id",
    "consumption_id",
    "idempotency_key",
    "target_operation_id",
    "target_state_before_digest",
    "target_state_after_digest",
    "probe_exit_status_or_http_status",
    "denial_layer",
    "target_audit_event_id",
    "bind_receipt_hash",
    "outcome_hash",
    "reconciliation_evidence_hash",
    "artifact_manifest_sha256"
  ],
  "proof_conjunction": [
    "approved_mutation_reaches_target_exactly_once",
    "unapproved_governed_request_has_no_target_effect",
    "direct_agent_has_no_route_to_target",
    "reachable_untrusted_client_is_rejected_by_target_tls",
    "reachable_authenticated_unscoped_identity_is_rejected_by_target_policy",
    "consumed_authorization_replay_has_no_new_effect",
    "target_or_scope_substitution_has_no_effect",
    "independent_target_state_records_exactly_one_grant",
    "all_attempts_and_denials_have_correlated_evidence",
    "tested_checkout_and_runtime_topology_are_verifiable",
    "no_secret_material_in_artifacts"
  ],
  "non_claims": [
    "No real external enterprise IAM, customer credentials or IdP integrated.",
    "Local certificate/role policy is a simulated IAM enforcement boundary, not cloud IAM verification.",
    "GitHub-hosted Docker runner is not an adversarially controlled host or security certification.",
    "No resistance claimed to host root, docker.sock exposure, stolen executor credentials or compromised trusted executor.",
    "A generated template is not a passing proof; only retained exact-SHA runtime evidence can support a bounded claim.",
    "Hash agreement demonstrates consistency against an expected artifact, not independent source authenticity."
  ],
  "required_runtime_artifacts": [
    "report.json",
    "evidence.json",
    "target_audit.jsonl",
    "independent_target_snapshot.json",
    "topology.json",
    "manifest.sha256"
  ],
  "completion_requires": "runtime runner + independent verifier + retained exact-SHA main artifact + third-party reproduction"
}
